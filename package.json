{
  "name": "tg-forward-web",
  "version": "1.0.0",
  "description": "Telegram post forwarding web app (Node.js + MongoDB + HTML/CSS/JS)",
  "main": "src/app.js",
  "scripts": {
    "start": "node server.js",
    "webhook:set": "node scripts/telegram-webhook.js set",
    "webhook:delete": "node scripts/telegram-webhook.js delete",
    "webhook:info": "node scripts/telegram-webhook.js info"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.8.0",
    "nodemailer": "^10.3.1"
  }
}
