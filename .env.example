PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=tgforward
BOT_TOKEN=replace_with_telegram_bot_token
JWT_SECRET=replace_with_a_long_random_secret

# Polling for a persistent server; webhook for Vercel.
BOT_MODE=polling
TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_secret

SMTP_HOST=smtp.yandex.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_full_yandex_email
SMTP_PASS=your_yandex_app_password
SMTP_FROM="Post Forwarder <your_full_yandex_email>"
